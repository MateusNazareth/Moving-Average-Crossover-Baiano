# =============================================================================
# Kraken Bot — Environment Configuration
# Rename this file to ".env" and fill in your values.
# NEVER commit this file to git or share it with anyone.
# =============================================================================

# ── Kraken API Credentials ────────────────────────────────────────────────────
KRAKEN_API_KEY=your_api_key_here
KRAKEN_API_SECRET=your_api_secret_here

# ── Trading Mode ──────────────────────────────────────────────────────────────
# "paper" = simulate trades, no real money
# "live"  = place real orders on Kraken — USE WITH CAUTION
TRADING_MODE=paper

# ── Pairs to trade (comma-separated) ─────────────────────────────────────────
PAIRS=BTC/USD,BTC/USDT,SOL/USD,SOL/USDT

# ── Bot Settings ──────────────────────────────────────────────────────────────
CANDLE_LIMIT=200        # number of 1-min candles to fetch per cycle
LOOP_INTERVAL=60        # seconds between each full scan cycle

# ── Paper Trading ─────────────────────────────────────────────────────────────
PAPER_EQUITY=10000      # starting virtual equity in USD
